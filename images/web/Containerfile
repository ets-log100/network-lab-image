ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        nginx-light \
        openssl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/nginx/lab /srv/www/default /tmp/nginx

COPY nginx.conf /etc/nginx/nginx.conf
COPY index.html /srv/www/default/index.html

LABEL org.opencontainers.image.title="Service Web de réseautique LOG100" \
      org.opencontainers.image.description="Point de terminaison HTTP/HTTPS local et contrôlé pour les laboratoires LOG100"

EXPOSE 8080 8443

HEALTHCHECK --interval=10s --timeout=2s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/healthz >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
