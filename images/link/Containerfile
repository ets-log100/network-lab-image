ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

COPY linkemu.py /usr/local/bin/linkemu
RUN chmod 0755 /usr/local/bin/linkemu

LABEL org.opencontainers.image.title="Émulateur de conditions réseau LOG100" \
      org.opencontainers.image.description="Proxy TCP/UDP en espace utilisateur pour délai, variation, capacité et perte contrôlés"

EXPOSE 5201/tcp 8080/tcp 7000/udp
ENTRYPOINT ["/usr/local/bin/linkemu"]
