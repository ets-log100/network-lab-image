ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bind9 \
        bind9-utils \
        ca-certificates \
        dnsutils \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/bind/lab /var/cache/bind \
    && chown bind:bind /var/cache/bind

COPY named.conf /etc/bind/named.conf
COPY named.conf.health /etc/bind/named.conf.health
COPY db.health.log100 /etc/bind/db.health.log100
COPY named.conf.lab /etc/bind/lab/named.conf.lab

LABEL org.opencontainers.image.title="DNS de réseautique LOG100" \
      org.opencontainers.image.description="Service DNS BIND contrôlé pour les laboratoires LOG100"

EXPOSE 53/tcp 53/udp

HEALTHCHECK --interval=10s --timeout=2s --retries=3 \
    CMD test "$(dig +short +time=1 +tries=1 @127.0.0.1 health.log100. A)" = "127.0.0.1" || exit 1

CMD ["/usr/sbin/named", "-g", "-u", "bind", "-c", "/etc/bind/named.conf"]
